TELEGRAM_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_key
OWNER_ID=5410368885
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
DB_FILE=workspace/memory.db
DEFAULT_MODE=strict
ARTIFACT_DIR=workspace/artifacts
BACKUP_DIR=workspace/backups
FILE_MEMORY_ROOT=workspace
ALLOWED_WRITE_ROOT=/path/to/xobops-dev-clean
READ_ROOT=/path/to/xobops-dev-clean
ALLOW_RAW_SHELL=1
USE_CAPABILITY_FACADE_SHELL=0
USE_SHELL_REPLAY_CONTROLLER=0
PANIC_UNLOCK_CODE=replace_with_high_entropy_secret
